# Токен от @BotFather
BOT_TOKEN=

# Telegram ID аккаунта, который может создавать обмены
ORGANIZER_TELEGRAM_ID=

# Публичный HTTPS-адрес Mini App, например https://username.github.io/santa/app/
# Публичный HTTPS-адрес API указывается в docs/app/config.js перед публикацией.
MINI_APP_URL=

# Интерфейс Node.js для API. Для обратного прокси на том же сервере оставьте 127.0.0.1.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/santa.sqlite
